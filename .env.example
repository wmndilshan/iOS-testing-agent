# Copy this file to `.env` in the project root and fill in what you use. `.env` is git-ignored: never commit real keys.
#   cp .env.example .env
# Real environment variables win over this file.

# --- Models -------------------------------------------------------------------------------------------------
# Screenshot judge and the Gemini planner. https://aistudio.google.com/apikey  (LLM_API_KEY is accepted as an alias)
GEMINI_API_KEY=
# Planner for the case runner and the agent team. https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional: override the Gemini model (GEMINI_MODEL or LLM_MODEL).
# GEMINI_MODEL=

# --- Test case source (optional) ---------------------------------------------------------------------------
# Only to fetch cases by number from AIO Tests (Jira). Hand-written cases in TestCases/ need none of this.
# AIO_API_KEY=
# AIO_PROJECT=
# AIO_BASE_URL=https://tcms.aiojiraapps.com/aio-tcms/api/v1

# --- Login used by test steps (optional) -------------------------------------------------------------------
# For cases with a login step. The password is read here at run time and never written into a case, a report or a prompt.
# TEST_USER_USERNAME=
# TEST_USER_PASSWORD=

# --- Tuning (all optional) ---------------------------------------------------------------------------------
# Path of idb when it is not in .venv-idb, /opt/homebrew/bin or /usr/local/bin.
# ATA_IDB_PATH=
# The project whose TestCases/ and .runs/ are used (default: the current folder).
# ATA_PROJECT_ROOT=
# Seconds a run waits for you (a login, a code, an approval) before it stops. Default 600.
# ATA_USER_WAIT_SECONDS=600
# Logging: trace|debug|info|notice|warning|error|fault, and where it goes (1 = on).
# ATA_LOG_LEVEL=info
# ATA_LOG_CONSOLE=0
# ATA_LOG_FILE=0
# Bearer token for `ata-mcp --http=<port>` (a random one is printed when this is empty).
# ATA_MCP_TOKEN=
